{
  "name": "aerodance",
  "version": "1.0.0",
  "description": "React + three.js canvas served by Express, realtime via Socket.IO, backed by TimescaleDB",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "private": true
}
