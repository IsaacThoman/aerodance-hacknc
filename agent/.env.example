# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Devnet only: the agent refuses to start on any other cluster.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Where the dance game is served; battle links look like ${BATTLE_BASE_URL}/battle/<id>?p=<token>
BATTLE_BASE_URL=http://localhost:5173

# HTTP API port for teammates.
PORT=4000

# Where phones reach this server (the QR code points here). Defaults to http://<your LAN IP>:PORT.
# Use an https tunnel (e.g. cloudflared) or the deployed domain for the demo.
PUBLIC_URL=

# Photon dashboard token so the join page can add phone numbers to the allowlist.
# Get it with `npx @photon-ai/cli login`, then copy accessToken from the credentials file. Expires after 7 days.
PHOTON_TOKEN=
