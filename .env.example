# Local app port (host mapping in compose.local.yaml; Express port when running npm run dev)
PORT=3000
# Local-only credentials. Set a strong, URL-safe POSTGRES_PASSWORD in Coolify.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aerodance
# Local database host port. Match the port in DATABASE_URL if you change it.
DB_PORT=5432
# Local dev (db from compose). For Tiger Cloud, paste your service URL and keep ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aerodance
