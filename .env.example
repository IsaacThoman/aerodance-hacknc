# Local app port (host mapping in compose.local.yaml; Express port when running npm run dev)
PORT=3000
# Local-only credentials. Set a strong, URL-safe POSTGRES_PASSWORD in Coolify.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aerodance
# Local database host port. Match the port in DATABASE_URL if you change it.
DB_PORT=5432
# Local dev (db from compose). For Tiger Cloud, paste your service URL and keep ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aerodance
# The agent (agent/): Solana devnet + iMessage worker. `npm run dev` here runs only the app,
# so start it separately with `npm run dev` in agent/ (it reads this file too).
AGENT_URL=http://localhost:4000
APP_URL=http://localhost:3001
# Shared secret for app <-> agent internal calls. Optional locally; set a random value in Coolify.
INTERNAL_SECRET=
# Where battle links texted by the bot point (the deployed domain in production).
PUBLIC_URL=http://localhost:3000
TROPHY_RENDERER_URL=http://localhost:4001
SOLANA_RPC_URL=https://api.devnet.solana.com
# Devnet treasury that funds new wallets and signs receipts. Make one with `npm run treasury` in agent/.
SOLANA_TREASURY_SECRET=
# Photon Spectrum credentials for the iMessage bot. Leave empty to keep the bot off (texts are logged).
PROJECT_ID=
PROJECT_SECRET=
# Photon dashboard token for adding numbers to the allowlist. Expires after 7 days:
# `npx @photon-ai/cli login`, then copy accessToken from the credentials file.
PHOTON_TOKEN=
